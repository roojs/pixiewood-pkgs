diff --git a/winpr/libwinpr/crt/unicode_android.c b/winpr/libwinpr/crt/unicode_android.c
index 4d5e6f7..8a9b0c1 100644
--- a/winpr/libwinpr/crt/unicode_android.c
+++ b/winpr/libwinpr/crt/unicode_android.c
@@ -19,6 +19,7 @@
  */
 
 #include <winpr/config.h>
+#include <stdint.h>
 #include <winpr/assert.h>
 #include <winpr/string.h>
 
@@ -100,13 +101,171 @@ static int convert_int(JNIEnv* env, const void* data, size_t size, void* buffer,
 	return rlen;
 }
 
+static int emit_utf16(uint32_t cp, WCHAR* dst, size_t cap, size_t* used, BOOL query)
+{
+	unsigned units = (cp > 0xFFFF) ? 2 : 1;
+	if (!query)
+	{
+		if (*used + units > cap)
+		{
+			SetLastError(ERROR_INSUFFICIENT_BUFFER);
+			return 0;
+		}
+		if (units == 1)
+			dst[*used] = (WCHAR)cp;
+		else
+		{
+			cp -= 0x10000;
+			dst[*used] = (WCHAR)(0xD800 + (cp >> 10));
+			dst[*used + 1] = (WCHAR)(0xDC00 + (cp & 0x3FF));
+		}
+	}
+	*used += units;
+	return 1;
+}
+
+/* JNI_OnLoad does not run when the linker loads libwinpr3.so, so jniVm stays
+ * null. The Java String conversion cannot run. This is UTF-16LE, the same
+ * encoding convert_int asks Java for. */
+static int convert_plain(const void* data, size_t size, void* buffer, size_t buffersize,
+                         BOOL toUTF16)
+{
+	const uint8_t* src = (const uint8_t*)data;
+	BOOL query = (buffersize == 0);
+	size_t used = 0;
+
+	if (size == 0)
+		return 0;
+
+	if (toUTF16)
+	{
+		WCHAR* dst = (WCHAR*)buffer;
+		size_t cap = buffersize / sizeof(WCHAR);
+		size_t i = 0;
+		while (i < size)
+		{
+			uint32_t cp;
+			unsigned need;
+			uint8_t b = src[i];
+			if (b < 0x80)
+			{
+				cp = b;
+				need = 1;
+			}
+			else if ((b & 0xE0) == 0xC0 && b >= 0xC2)
+			{
+				cp = b & 0x1F;
+				need = 2;
+			}
+			else if ((b & 0xF0) == 0xE0)
+			{
+				cp = b & 0x0F;
+				need = 3;
+			}
+			else if ((b & 0xF8) == 0xF0 && b <= 0xF4)
+			{
+				cp = b & 0x07;
+				need = 4;
+			}
+			else
+				return -1;
+			if (i + need > size)
+				return -1;
+			for (unsigned n = 1; n < need; n++)
+			{
+				uint8_t c = src[i + n];
+				if ((c & 0xC0) != 0x80)
+					return -1;
+				cp = (cp << 6) | (c & 0x3F);
+			}
+			i += need;
+			if ((need == 3 && cp < 0x800) || (need == 4 && cp < 0x10000))
+				return -1;
+			if (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF))
+				return -1;
+			if (!emit_utf16(cp, dst, cap, &used, query))
+				return 0;
+		}
+		return (int)used;
+	}
+
+	uint8_t* dst = (uint8_t*)buffer;
+	size_t cap = buffersize;
+	size_t i = 0;
+	if (size % sizeof(WCHAR) != 0)
+		return -1;
+	while (i + sizeof(WCHAR) <= size)
+	{
+		uint32_t cp = (uint32_t)src[i] | ((uint32_t)src[i + 1] << 8);
+		unsigned bytes;
+		i += sizeof(WCHAR);
+		if (cp >= 0xD800 && cp <= 0xDBFF)
+		{
+			uint32_t low;
+			if (i + sizeof(WCHAR) > size)
+				return -1;
+			low = (uint32_t)src[i] | ((uint32_t)src[i + 1] << 8);
+			i += sizeof(WCHAR);
+			if (low < 0xDC00 || low > 0xDFFF)
+				return -1;
+			cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
+		}
+		else if (cp >= 0xDC00 && cp <= 0xDFFF)
+			return -1;
+		if (cp < 0x80)
+			bytes = 1;
+		else if (cp < 0x800)
+			bytes = 2;
+		else if (cp < 0x10000)
+			bytes = 3;
+		else
+			bytes = 4;
+		if (!query)
+		{
+			if (used + bytes > cap)
+			{
+				SetLastError(ERROR_INSUFFICIENT_BUFFER);
+				return 0;
+			}
+			if (bytes == 1)
+				dst[used] = (uint8_t)cp;
+			else if (bytes == 2)
+			{
+				dst[used] = (uint8_t)(0xC0 | (cp >> 6));
+				dst[used + 1] = (uint8_t)(0x80 | (cp & 0x3F));
+			}
+			else if (bytes == 3)
+			{
+				dst[used] = (uint8_t)(0xE0 | (cp >> 12));
+				dst[used + 1] = (uint8_t)(0x80 | ((cp >> 6) & 0x3F));
+				dst[used + 2] = (uint8_t)(0x80 | (cp & 0x3F));
+			}
+			else
+			{
+				dst[used] = (uint8_t)(0xF0 | (cp >> 18));
+				dst[used + 1] = (uint8_t)(0x80 | ((cp >> 12) & 0x3F));
+				dst[used + 2] = (uint8_t)(0x80 | ((cp >> 6) & 0x3F));
+				dst[used + 3] = (uint8_t)(0x80 | (cp & 0x3F));
+			}
+		}
+		used += bytes;
+	}
+	return (int)used;
+}
+
 static int convert(const void* data, size_t size, void* buffer, size_t buffersize, BOOL toUTF16)
 {
 	int rc;
 	JNIEnv* env = nullptr;
+
+	if (!jniVm)
+		return convert_plain(data, size, buffer, buffersize, toUTF16);
+
 	jboolean attached = winpr_jni_attach_thread(&env);
+	if (!env)
+		return convert_plain(data, size, buffer, buffersize, toUTF16);
 	rc = convert_int(env, data, size, buffer, buffersize, toUTF16);
 	if (attached)
 		winpr_jni_detach_thread();
 	return rc;
 }
