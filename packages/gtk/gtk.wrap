[wrap-git]
url = https://gitlab.gnome.org/GNOME/gtk.git
# Native GTK. This is the default target (packages/gtk/targets name "gnome").
# Upstream GNOME is built as-is. Android fixes are not patched onto this tree.
# --gtk ime selects Knowles/gtk branch android-ime, which carries those fixes.
