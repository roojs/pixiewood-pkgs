[wrap-git]
directory = harfbuzz
url = https://github.com/harfbuzz/harfbuzz.git
push-url = git@github.com:harfbuzz/harfbuzz.git
# GTK nested wrap uses tag 14.4.0. Pango 1.58.2 needs harfbuzz >= 11.0.0.
# Tag 14.4.0 peels to 36cb489cb02ce4b92099669ba9f9bea348eff93f.
revision = 14.4.0
depth = 1

[provide]
harfbuzz = libharfbuzz_dep
harfbuzz-subset = libharfbuzz_subset_dep
