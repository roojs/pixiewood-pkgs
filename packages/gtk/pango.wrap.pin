[wrap-git]
directory = pango
url = https://gitlab.gnome.org/GNOME/pango.git
push-url = ssh://git@ssh.gitlab.gnome.org:GNOME/pango.git
# GTK's wrap tracks main (nightly docs). Pin 1.58.2, which still provides
# pangocairo. The package itself is packages/pango/pango.wrap. This file stays
# *.wrap.pin so it is not a second top-level wrap next to that package.
revision = 1.58.2
depth = 1

[provide]
pango = libpango_dep
pangoft2 = libpangoft2_dep
pangoxft = libpangoxft_dep
pangowin32 = libpangowin32_dep
pangocairo = libpangocairo_dep
